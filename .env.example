# Copy to .env for local dev (never commit .env itself)

# Base URL for podcast audio, served from Cloudflare R2 (bucket: ahmed-podcasts).
# Use the R2 public bucket / r2.dev URL for now, or media.ahmedalishah.com once
# that custom domain is connected in the R2 bucket's Settings -> Custom Domains.
# No trailing slash.
PUBLIC_PODCAST_MEDIA_URL=https://media.ahmedalishah.com
