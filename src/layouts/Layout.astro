---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  activePage?: 'home' | 'about' | 'projects' | 'blog' | 'contact' | 'podcasts' | 'services';
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = "Software Developer — full-stack, blockchain & AI. Portfolio of Syed Ahmed Ali Shah.",
  activePage,
  ogImage = '/images/og-image.png',
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:site_name" content="Syed Ahmed Ali Shah" />
  <meta name="author" content="Syed Ahmed Ali Shah" />

  <slot name="head" />

  <meta name="google-site-verification" content="K3dnbx54uUMbwm_4kuaA5Uhmd_93XKVKSFD4WUdaP6M" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <script>
    // @ts-ignore
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<Navbar activePage={activePage} />

<main id="main">
<slot /></main>

<Footer />

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll('.reveal');
  if (prefersReduced) {
    items.forEach(el => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    items.forEach(el => io.observe(el));
  }
</script>

<script>
  // Lightweight conversion-event tracking via Vercel Analytics' custom events
  // (window.va, already loaded above). Any element with data-track="EventName"
  // fires that event on click — one delegated listener, no per-page scripts.
  // See: https://vercel.com/docs/analytics/custom-events
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-track]') as HTMLElement | null;
    if (!target) return;
    const name = target.getAttribute('data-track');
    if (!name) return;
    const data: Record<string, string> = {};
    for (const attr of Array.from(target.attributes)) {
      if (attr.name.startsWith('data-track-')) {
        data[attr.name.replace('data-track-', '')] = attr.value;
      }
    }
    // @ts-ignore
    if (window.va) window.va('event', { name, data });
  });
</script>

<script>
  // Mobile-only: hide the nav when scrolling down, bring it back on any upward
  // scroll. Uses a passive listener + rAF throttle so it costs nothing on the
  // scroll path. Desktop keeps the nav pinned.
  (() => {
    const nav = document.querySelector('.nav') as HTMLElement | null;
    if (!nav) return;

    const HIDE_AFTER = 120;   // don't hide until past this, avoids flicker at the top
    const DELTA = 6;          // ignore jitter smaller than this
    let lastY = window.scrollY;
    let ticking = false;

    const isMobile = () => window.matchMedia('(max-width: 860px)').matches;

    const update = () => {
      ticking = false;
      const y = window.scrollY;

      if (!isMobile()) { nav.classList.remove('nav-hidden'); lastY = y; return; }
      // never hide while the mobile menu is open
      if (document.querySelector('.mobile-menu.open')) { nav.classList.remove('nav-hidden'); lastY = y; return; }

      const diff = y - lastY;
      if (Math.abs(diff) < DELTA) return;

      if (diff > 0 && y > HIDE_AFTER) nav.classList.add('nav-hidden');
      else if (diff < 0) nav.classList.remove('nav-hidden');

      lastY = y;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
  })();
</script>

</body>
</html>