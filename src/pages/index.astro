---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SkillGroup from '../components/SkillGroup.astro';
import CertificateCard from '../components/CertificateCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FeaturedEpisode from '../components/FeaturedEpisode.astro';
import EpisodeRow from '../components/EpisodeRow.astro';
import resume from '../data/resume.json';
import servicesData from '../data/services.json';
import { getPodcastAudioUrl } from '../lib/podcast';

const projects = resume.projects;

// Homepage selection is driven by `featured` / `homepageOrder` in resume.json,
// not by array position — reordering the file no longer changes what's shown.
const homepageProjects = projects
  .filter(p => p.featured)
  .sort((a, b) => (a.homepageOrder ?? 99) - (b.homepageOrder ?? 99));

const featured = homepageProjects[0];
const topTwo = homepageProjects.slice(1, 3);

// Experience: split the combined "meta" string into period + location
function splitMeta(meta: string) {
  const [period, ...rest] = meta.split('·').map(s => s.trim());
  return { period, location: rest.join(' · ') };
}

function readTime(body: string) {
  return Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));
}

const certs = resume.certificates;

// Person + WebSite structured data for the homepage. Values come from
// resume.json so they stay in sync with the rest of the site.
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": resume.name,
  "jobTitle": resume.role,
  "url": siteUrl,
  "email": `mailto:${resume.contact.email}`,
  "address": { "@type": "PostalAddress", "addressLocality": resume.contact.location },
  "sameAs": [resume.contact.github, resume.contact.linkedin],
  "knowsAbout": resume.projects.flatMap((p: any) => p.stack).filter((v: string, i: number, a: string[]) => a.indexOf(v) === i),
};
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": `${resume.name} — Portfolio`,
  "url": siteUrl,
  "author": { "@type": "Person", "name": resume.name },
};
---
<Layout title="Syed Ahmed Ali Shah — Software Developer" activePage="home">
<script type="application/ld+json" set:html={JSON.stringify(personLd)} slot="head" />
<script type="application/ld+json" set:html={JSON.stringify(websiteLd)} slot="head" />

<!-- ================= HERO ================= -->
<section class="hero">
  <div class="shell">
    <span class="badge"><span class="badge-dot"></span>Available for freelance opportunities</span>

    <h1 class="hero-title">Software developer building <span class="hero-title-accent">useful things for the web.</span></h1>

    <p class="hero-sub">
      I'm {resume.name} — a full-stack software developer working across React,
      Node.js, Python, databases, Solidity, blockchain, and applied AI.
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#work">View Selected Work</a>
      <a class="btn btn-secondary" href="/contact">Get in Touch <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <div class="hero-meta">
      <a href={resume.contact.github} target="_blank" rel="noopener" data-track="github_click" data-track-source="hero">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={resume.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href="/api/resume" download="Ahmed_Ali_Shah_Resume.pdf">Resume</a>
    </div>
  </div>
</section>

<hr class="rule" />

<!-- ================= SELECTED WORK ================= -->
<section class="section" id="work">
  <div class="shell">
    <SectionHeader
      kicker="Selected Work"
      title="Things I've designed, built and shipped."
      intro="A few projects where the engineering decisions mattered — each one deployed and publicly verifiable."
    />

    <div class="work-grid reveal">
      {topTwo.map(p => (
        <ProjectCard
          name={p.name}
          desc={p.longDesc ?? p.shortDesc}
          stack={p.stack.slice(0, 5)}
          url={p.url}
          tag={p.tag}
          accent={p.accent ?? '#2563EB'}
          screenshot={p.screenshot ?? null}
          caseStudySlug={p.caseStudy?.slug ?? null}
        />
      ))}
    </div>

    <div class="work-featured reveal">
      <ProjectCard
        name={featured.name}
        desc={featured.longDesc}
        stack={featured.stack}
        url={featured.url}
        tag={featured.tag}
        featured={true}
        accent={featured.accent ?? '#2563EB'}
        screenshot={featured.screenshot ?? null}
        caseStudySlug={featured.caseStudy?.slug ?? null}
      />
    </div>

    <div class="work-more reveal">
      <a class="arrow-link" href="/projects">See all {projects.length} projects <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<hr class="rule" />

<!-- ================= EXPERIENCE ================= -->
<section class="section" id="experience">
  <div class="shell">
    <SectionHeader kicker="Experience" title="Where I've worked." />

    <div class="exp-list reveal">
      {resume.experience.map(job => {
        const { period, location } = splitMeta(job.meta);
        return (
          <ExperienceItem
            period={period}
            location={location}
            org={job.org}
            role={job.title}
            bullets={job.bullets}
          />
        );
      })}
    </div>
  </div>
</section>

<hr class="rule" />

<!-- ================= SKILLS ================= -->
<section class="section" id="skills">
  <div class="shell">
    <SectionHeader
      kicker="Capabilities"
      title="Technologies I work with."
      intro="Grouped by what they're actually for, rather than a wall of logos."
    />

    <div class="skills-grid reveal">
      {Object.entries(resume.skills).map(([group, items]) => (
        <SkillGroup title={group} items={items} />
      ))}
    </div>
  </div>
</section>

<hr class="rule" />

<!-- ================= SERVICES PREVIEW ================= -->
<section class="section" id="services">
  <div class="shell">
    <SectionHeader
      kicker="Services"
      title="How I can help."
      intro="Software development and technical services, grounded in things I've actually built and run in production."
    />

    <div class="services-preview reveal">
      {servicesData.services.map(s => (
        <a class="service-preview-card" href={`/services/${s.slug}`}>
          <h3>{s.navLabel}</h3>
          <p>{s.shortDesc}</p>
        </a>
      ))}
    </div>

    <div class="work-more reveal">
      <a class="arrow-link" href="/services">View all services <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<hr class="rule" />

<!-- ================= EDUCATION ================= -->
<section class="section" id="education">
  <div class="shell">
    <SectionHeader kicker="Education" title="Background." />

    <div class="edu-list reveal">
      {resume.education.map(e => (
        <div class="edu-item">
          <span class="edu-logo-wrap">
            <img src={e.logo} alt={`${e.school} logo`} width="44" height="44" loading="lazy" decoding="async" />
          </span>
          <div>
            <h3>{e.degree}</h3>
            <p>{e.school}</p>
            <span>{e.date}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<hr class="rule" />

<!-- ================= CERTIFICATIONS ================= -->
<section class="section" id="certifications">
  <div class="shell">
    <SectionHeader kicker="Certifications" title={`${certs.length} credentials.`} />

    <div class="certs-grid reveal" id="certsGrid">
      {certs.map((c, i) => (
        <div class={i >= 4 ? 'cert-hidden' : ''}>
          <CertificateCard title={c.title} issuer={c.issuer} date={c.date} url={c.url} image={c.image} />
        </div>
      ))}
    </div>
    {certs.length > 4 && (
      <div class="reveal" style="text-align:center;">
        <button class="btn btn-secondary certs-toggle" id="certsToggle" aria-expanded="false">
          View all certifications
        </button>
      </div>
    )}
  </div>
</section>

<ContactCTA />

<style>
  /* ---------- Hero ---------- */
  .hero{position:relative;padding:110px 0 96px;overflow:hidden;}
  .hero::before{
    content:"";position:absolute;top:-220px;right:-160px;width:620px;height:620px;
    background:radial-gradient(circle, rgba(37,99,235,0.07) 0%, transparent 68%);
    pointer-events:none;
  }
  .hero > .shell{position:relative;}
  .hero-title{
    margin-top:26px;
    font-size:clamp(38px,6.2vw,70px);
    line-height:1.04;
    letter-spacing:-0.035em;
    max-width:17ch;
  }
  .hero-title-accent{
    font-family:var(--font-serif);
    font-style:italic;
    font-weight:500;
    letter-spacing:-0.01em;
  }
  .hero-sub{
    margin:26px 0 0;
    font-size:clamp(17px,1.6vw,20px);
    line-height:1.65;color:var(--muted);max-width:60ch;
  }
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:38px;}
  .hero-meta{
    display:flex;flex-wrap:wrap;align-items:center;gap:14px;
    margin-top:34px;font-size:14.5px;color:var(--muted);
  }
  .hero-meta a{font-weight:500;color:var(--body);transition:color .18s ease;}
  .hero-meta a:hover{color:var(--accent);}
  @media (max-width:768px){ .hero{padding:72px 0 64px;} }

  /* ---------- Work ---------- */
  .work-grid{
    display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:48px;
  }
  .work-featured{margin-top:24px;}
  .work-more{margin-top:36px;}
  @media (max-width:900px){ .work-grid{grid-template-columns:1fr;} }

  /* ---------- Experience ---------- */
  .exp-list{margin-top:44px;border-bottom:1px solid var(--line);}

  /* ---------- Skills ---------- */
  .skills-grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:36px;margin-top:48px;
  }
  @media (max-width:900px){ .skills-grid{grid-template-columns:repeat(2,1fr);gap:32px;} }
  @media (max-width:520px){ .skills-grid{grid-template-columns:1fr;} }

  /* ---------- Writing ---------- */
  /* ---------- Services preview ---------- */
  .services-preview{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:44px;}
  @media (max-width:900px){ .services-preview{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:560px){ .services-preview{grid-template-columns:1fr;} }
  .service-preview-card{
    display:block;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:22px;transition:border-color .2s ease, transform .2s ease;
  }
  .service-preview-card:hover{border-color:var(--line-strong);transform:translateY(-2px);}
  .service-preview-card h3{font-size:17px;letter-spacing:-0.015em;}
  .service-preview-card p{margin:8px 0 0;font-size:14.5px;color:var(--muted);line-height:1.6;}

  .writing-list{margin-top:40px;border-bottom:1px solid var(--line);}

  /* ---------- Podcast ---------- */
  .podcast-featured{margin-top:48px;}
  .podcast-recent{margin-top:48px;border-bottom:1px solid var(--line);}

  /* ---------- Education ---------- */
  .edu-list{
    margin-top:44px;display:grid;grid-template-columns:repeat(2,1fr);gap:28px;
  }
  @media (max-width:640px){ .edu-list{grid-template-columns:1fr;} }
  .edu-item{
    display:flex;gap:16px;align-items:flex-start;
    background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px;
  }
  .edu-logo-wrap{
    flex-shrink:0;width:44px;height:44px;display:flex;align-items:center;justify-content:center;
    background:#FFFFFF;border:1px solid var(--line);border-radius:10px;padding:5px;
  }
  .edu-logo-wrap img{width:100%;height:100%;object-fit:contain;}
  .edu-item h3{font-size:17px;letter-spacing:-0.015em;}
  .edu-item p{margin:3px 0 0;font-size:15px;color:var(--muted);}
  .edu-item span{display:block;margin-top:5px;font-family:var(--font-mono);font-size:12.5px;color:var(--muted);}

  /* ---------- Certifications ---------- */
  .certs-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:44px;align-items:stretch;}
  .certs-grid > div:not(.cert-hidden){display:flex;}
  .certs-grid > div > :global(*){width:100%;}
  @media (min-width:900px){ .certs-grid{grid-template-columns:repeat(4,1fr);} }
  @media (max-width:560px){ .certs-grid{grid-template-columns:1fr;} }
  .cert-hidden{display:none;}
  .certs-grid.expanded .cert-hidden{display:flex;}
  .certs-toggle{margin-top:28px;}
</style>

<script>
  const grid = document.getElementById('certsGrid');
  const toggle = document.getElementById('certsToggle');
  toggle?.addEventListener('click', () => {
    const expanded = grid?.classList.toggle('expanded');
    toggle.setAttribute('aria-expanded', String(!!expanded));
    toggle.textContent = expanded ? 'Show fewer certifications' : 'View all certifications';
  });
</script>

</Layout>
