---
import Layout from '../layouts/Layout.astro';
import resume from '../data/resume.json';

---
<Layout title="Syed Ahmed Ali Shah — Software Developer" activePage="home">

<div class="wrap">

  <section class="hero" style="padding:72px 0 56px;">
    <div class="hero-aurora">
    <div class="aurora-blob aurora-1"></div>
    <div class="aurora-blob aurora-2"></div>
    <div class="aurora-blob aurora-3"></div>
    <div class="hero-content">
      <h1>Syed Ahmed<br/>Ali Shah</h1>
      <div class="role-rotator"><span id="rrText">Software Developer</span><span class="rr-cursor"></span></div>
      <p class="lede">5+ years building web, mobile, and database-driven applications. Currently freelancing across React, Node.js, Python and Solidity — shipping deployed, working products rather than mockups.</p>

      <div class="contact-row">
        <span class="chip" id="emailChip">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="m4 6 8 7 8-7"/></svg>
          <span class="chip-label">{resume.contact.email}</span>
        </span>
        <a class="chip" href={resume.contact.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.7 2.8 5.6 3.1 5.6 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.2 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
          {resume.contact.githubLabel}
        </a>
        <a class="chip" href={resume.contact.linkedin} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/><path d="M10 9h4v2s1-2 4-2 4.5 2 4.5 6v7h-4v-6.5c0-1.5-.5-2.5-2-2.5s-2.3 1-2.3 2.5V21h-4z"/></svg>
          LinkedIn
        </a>
      </div>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/api/resume" download="Ahmed_Ali_Shah_Resume.pdf">↓ Download Resume (PDF)</a>
        <a class="btn btn-ghost" href="/contact">Say hello →</a>
      </div>
    </div>
    </div>
  </section>

  <section id="about">
    <div class="eyebrow">About</div>
    <div class="about-card">
      <p>Most recently a <span class="tag">Software Development Intern</span> at Sukkur IBA University's Department of Electrical Engineering, where I administered OJS journal systems, departmental web infrastructure, and office automation. Before that, three years remote at <span class="tag">Clear Edge Technology (Canada)</span> building Django/Flask and PostgreSQL solutions.</p>
      <p>Now building a freelance practice around full-stack development, smart contracts, and applied AI. <a href="/about" style="color:var(--signal);">Read the full story →</a></p>
    </div>
  </section>

  <section id="experience">
    <div class="eyebrow">Experience</div>
    <div class="commit-log">
      {resume.experience.map(job => (
        <div class="commit">
          <div class="commit-head">
            <span class="commit-role">{job.title} · {job.org}</span>
          </div>
          <div class="commit-meta">{job.meta}</div>
          <div class="commit-body">
            <ul>
              {job.bullets.map(b => <li>{b}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="skills">
    <div class="eyebrow">Skills</div>
    <div class="skill-groups">
      {Object.entries(resume.skills).map(([group, items]) => (
        <div>
          <div class="skill-group-title">{group}</div>
          <div class="pill-row">
            {items.map(item => <span class="pill">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="projects-preview">
    <div class="eyebrow">Projects — shipped &amp; deployed</div>
  </section>

  <section class="marquee-section" style="padding-top:0;">
    <div class="marquee-wrap">
      <div class="marquee-track">
        {[...resume.projects, ...resume.projects].map(p => (
          <a class="project-card marquee-card" href={p.url || '/projects'} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener' : undefined}>
            <div class="project-top">
              <span class="project-name">{p.name}</span>
              {p.tag && <span class="live-tag">{p.tag}</span>}
            </div>
            <div class="project-desc">{p.shortDesc}</div>
            <span class="project-link">Read the write-up →</span>
          </a>
        ))}
      </div>
    </div>
    <div style="margin-top:16px;text-align:center;"><a class="btn btn-ghost" href="/projects">See all projects →</a></div>
  </section>

  <section id="blog-preview">
    <div class="eyebrow">From the Blog</div>
    <a class="post-card" href="/blog/why-i-built-a-blockchain-notary">
      <img class="post-thumb" src="/images/banner-notary.svg" alt="" />
      <div class="post-date">Latest</div>
      <div class="post-title">Why I built a blockchain notary instead of another CRUD app</div>
      <div class="post-excerpt">On choosing Solidity over a database when the whole point is that nobody — including me — should be able to quietly edit the record.</div>
    </a>
    <div style="margin-top:8px;"><a class="btn btn-ghost" href="/blog">Read more posts →</a></div>
  </section>

  <section id="education">
    <div class="eyebrow">Education</div>
    <div class="two-col">
      {resume.education.map(edu => (
        <div style="display:flex;gap:14px;align-items:flex-start;">
          <div class={`edu-logo ${edu.school.includes('Islamia') ? 'edu-logo-badge' : ''}`}>
            <img src={edu.logo} alt={`${edu.school} logo`} />
          </div>
          <div>
            <div class="edu-degree">{edu.degree}</div>
            <div class="edu-school">{edu.school}</div>
            <div class="edu-date">{edu.date}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="certificates" class="alt-bg">
    <div class="eyebrow">Certificates</div>
    <div class="cert-carousel">
      <div class="cert-nav">
        <button id="certPrev" aria-label="Previous certificate">&larr;</button>
        <button id="certNext" aria-label="Next certificate">&rarr;</button>
      </div>
      <div class="cert-track" id="certTrack">
        {resume.certificates.map(cert => {
          const CardTag = cert.url ? 'a' : 'div';
          return (
            <CardTag class="cert-card" href={cert.url || undefined} target={cert.url ? '_blank' : undefined} rel={cert.url ? 'noopener' : undefined}>
              {cert.image ? (
                <img class="cert-thumb" src={cert.image} alt={`${cert.title} certificate`} />
              ) : (
                <div class="cert-thumb-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:32px;height:32px;"><circle cx="12" cy="8" r="6"/><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"/></svg>
                </div>
              )}
              <div class="cert-body">
                <div class="cert-title">{cert.title}</div>
                <div class="cert-issuer">{cert.issuer}</div>
                <div class="cert-when">{cert.date}</div>
              </div>
            </CardTag>
          );
        })}
      </div>
      <div class="cert-dots" id="certDots"></div>
    </div>
  </section>

</div>

<style>
  .hero-aurora{position:relative;overflow:hidden;border-radius:var(--radius);}
  .aurora-blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:0.55;pointer-events:none;z-index:0;}
  .aurora-1{width:420px;height:420px;background:#A259FF;top:-160px;left:-100px;animation:drift1 16s ease-in-out infinite alternate;}
  .aurora-2{width:360px;height:360px;background:#5B8CFF;top:20px;right:-120px;animation:drift2 20s ease-in-out infinite alternate;}
  .aurora-3{width:300px;height:300px;background:#FF5CA8;bottom:-140px;left:30%;animation:drift3 18s ease-in-out infinite alternate;opacity:0.35;}
  @keyframes drift1{from{transform:translate(0,0) scale(1);}to{transform:translate(40px,30px) scale(1.1);}}
  @keyframes drift2{from{transform:translate(0,0) scale(1);}to{transform:translate(-30px,40px) scale(0.95);}}
  @keyframes drift3{from{transform:translate(0,0) scale(1);}to{transform:translate(20px,-20px) scale(1.08);}}
  .hero-content{position:relative;z-index:1;padding:80px 48px 64px;}
  .hero-content h1{font-size:clamp(42px,7vw,80px);line-height:1.02;color:var(--paper);font-weight:700;}
  .role-rotator{font-family:'JetBrains Mono',monospace;color:var(--signal);font-size:clamp(16px,2.2vw,20px);margin-top:14px;min-height:1.4em;transition:opacity 0.3s ease;}
  .role-rotator .rr-cursor{display:inline-block;width:9px;height:1em;background:var(--signal);margin-left:3px;vertical-align:-2px;animation:blink 1s steps(1) infinite;}
  @keyframes blink{50%{opacity:0;}}
  .hero-content p.lede{color:var(--muted);margin-top:20px;max-width:60ch;font-size:15.5px;}
  .skill-groups{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
  @media (max-width:640px){.skill-groups{grid-template-columns:1fr;}}
  @media (min-width:1000px){.skill-groups{grid-template-columns:repeat(4,1fr);}}
  .project-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media (max-width:640px){.project-grid{grid-template-columns:1fr;}}
  @media (min-width:1000px){.project-grid{grid-template-columns:repeat(3,1fr);}}

  .marquee-wrap{overflow:hidden;-webkit-mask-image:linear-gradient(to right, transparent, black 40px, black calc(100% - 40px), transparent);mask-image:linear-gradient(to right, transparent, black 40px, black calc(100% - 40px), transparent);}
  .marquee-track{display:flex;gap:16px;width:max-content;animation:marquee-scroll 42s linear infinite;}
  .marquee-wrap:hover .marquee-track{animation-play-state:paused;}
  .marquee-card{flex:0 0 300px;text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:10px;}
  @keyframes marquee-scroll{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }
  @media (prefers-reduced-motion: reduce){
    .marquee-track{animation:none;}
    .marquee-wrap{overflow-x:auto;}
  }
</style>

<script>
  const emailChip = document.getElementById('emailChip');
  emailChip?.addEventListener('click', () => {
    const label = emailChip.querySelector('.chip-label');
    const original = label ? label.textContent : null;
    navigator.clipboard.writeText(original || '').then(() => {
      if (label) label.textContent = 'copied ✓';
      setTimeout(() => { if (label && original) label.textContent = original; }, 1400);
    });
  });

  const roles = ["Software Developer", "Blockchain Developer", "AI & Prompt Engineer", "Full-Stack Engineer"];
  const rrEl = document.getElementById('rrText');
  let rrIndex = 0;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (rrEl && !prefersReducedMotion) {
    setInterval(() => {
      rrIndex = (rrIndex + 1) % roles.length;
      (rrEl as HTMLElement).style.opacity = '0';
      setTimeout(() => {
        rrEl.textContent = roles[rrIndex];
        (rrEl as HTMLElement).style.opacity = '1';
      }, 300);
    }, 2600);
  }

  const certTrack = document.getElementById('certTrack');
  const certDotsWrap = document.getElementById('certDots');
  if (certTrack && certDotsWrap) {
    const certCards = certTrack.querySelectorAll('.cert-card');
    certCards.forEach((_, i) => {
      const dot = document.createElement('span');
      dot.addEventListener('click', () => {
        certCards[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
      certDotsWrap.appendChild(dot);
    });
    const certDots = certDotsWrap.children;

    function updateCertDots() {
      const scrollLeft = certTrack!.scrollLeft;
      let closest = 0, minDist = Infinity;
      certCards.forEach((c, i) => {
        const dist = Math.abs((c as HTMLElement).offsetLeft - (certTrack as HTMLElement).offsetLeft - scrollLeft);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      Array.from(certDots).forEach((d, i) => d.classList.toggle('active', i === closest));
    }
    certTrack.addEventListener('scroll', updateCertDots);
    updateCertDots();

    document.getElementById('certNext')?.addEventListener('click', () => {
      certTrack.scrollBy({ left: 236, behavior: 'smooth' });
    });
    document.getElementById('certPrev')?.addEventListener('click', () => {
      certTrack.scrollBy({ left: -236, behavior: 'smooth' });
    });
  }
</script>

</Layout>
