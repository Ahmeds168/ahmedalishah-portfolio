---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import services from '../../data/services.json';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": new URL('/services', Astro.site).toString() },
  ],
};
---
<Layout
  title="Software Development & Technical Services — Syed Ahmed Ali Shah"
  description="Full-stack development, Python automation, OJS support, Solidity/Foundry development, and AI integration services."
  activePage="services"
>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

<section class="page-head">
  <div class="shell">
    <SectionHeader
      as="h1"
      kicker="Services"
      title="Software Development & Technical Services"
      intro="I help businesses, researchers, organizations and developers build, maintain and troubleshoot modern software systems."
    />
  </div>
</section>

<hr class="rule" />

<section class="section-tight">
  <div class="shell">
    <div class="services-grid">
      {services.services.map(s => (
        <a class="service-card" href={`/services/${s.slug}`}>
          <h2>{s.navLabel}</h2>
          <p>{s.shortDesc}</p>
          <span class="arrow-link">Learn more <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<ContactCTA />

<style>
  .page-head{padding:72px 0 48px;}
  @media (max-width:768px){ .page-head{padding:52px 0 36px;} }

  .services-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
  @media (max-width:760px){ .services-grid{grid-template-columns:1fr;} }

  .service-card{
    display:block;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:28px;transition:border-color .2s ease, transform .2s ease;
  }
  .service-card:hover{border-color:var(--line-strong);transform:translateY(-2px);}
  .service-card h2{font-size:21px;letter-spacing:-0.02em;}
  .service-card p{margin:12px 0 20px;font-size:15.5px;color:var(--muted);line-height:1.65;}
</style>

</Layout>
