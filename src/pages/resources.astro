---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "Resources", "item": new URL('/resources', Astro.site).toString() },
  ],
};
---
<Layout
  title="Resources — Syed Ahmed Ali Shah"
  description="Guides, checklists, and templates from real project and OJS/Solidity/Foundry work — coming soon."
>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />

<section class="page-head">
  <div class="shell">
    <div class="kicker">Resources</div>
    <h1>Guides &amp; templates.</h1>
    <p class="intro">
      This page is where I'll share practical guides, checklists, and templates drawn
      from real project work — OJS upgrade checklists, Foundry test-suite starters, and
      similar things I've already built for myself. Nothing is published here yet.
    </p>
  </div>
</section>

<hr class="rule" />

<section class="section-tight">
  <div class="shell shell-narrow">
    <p class="empty-note">
      Nothing to show yet — check back later, or
      <a class="link" href="/blog">read the blog</a> and
      <a class="link" href="/podcasts">the podcast</a> in the meantime, both of which
      already cover a lot of the same ground in longer form.
    </p>
  </div>
</section>

<ContactCTA />

<style>
  .page-head{padding:72px 0 48px;}
  .page-head h1{margin-top:14px;font-size:clamp(30px,4vw,44px);letter-spacing:-0.03em;}
  .intro{margin:18px 0 0;font-size:17.5px;color:var(--muted);max-width:65ch;line-height:1.7;}
  @media (max-width:768px){ .page-head{padding:52px 0 36px;} }

  .shell-narrow{max-width:760px;}
  .empty-note{color:var(--muted);font-size:16px;line-height:1.7;}
</style>

</Layout>
