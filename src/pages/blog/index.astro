---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categoryLabel, categoryColor, categoryTextColor } from '../../data/categories';
import BlogSearch from '../../components/BlogSearch.tsx';
import BlogTopicFilters from '../../components/BlogTopicFilters.tsx';
import resume from '../../data/resume.json';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const topics = new Set(posts.map(p => p.data.category)).size;

function readTime(body: string) {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

function tagStyle(color: string, text: string) {
  const c = color === 'signal' ? 'var(--color-signal)' : color;
  return `background:${c}1A;color:${text};`;
}

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).toString() },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": new URL('/blog', Astro.site).toString() },
  ],
};
---
<Layout title="Blog — Syed Ahmed Ali Shah" description="Notes on the decisions behind Ahmed's projects — blockchain, systems administration, and applied AI." activePage="blog">
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />

<div class="max-w-[1120px] mx-auto px-5 lg:px-8 bg-canvas text-ink font-body">

  <section class="pt-12 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-mono text-[11px] text-accent uppercase tracking-widest">Blog</span>
      </div>
      <h1 class="font-display text-4xl md:text-5xl tracking-tight leading-[1.1]">Notes on software, security, and the occasional deep dive</h1>
      <p class="text-muted max-w-[62ch]">Short write-ups on the decisions behind the projects, plus analysis of things happening elsewhere in software and security.</p>
    </div>
    <div class="flex items-center gap-3 self-start md:self-end shrink-0">
      <div class="bg-subtle px-3 py-1.5 rounded-lg flex items-center gap-2 border border-line">
        <span class="font-mono text-[11px] text-muted">POSTS:</span>
        <span class="font-mono text-[12px] text-ink">{String(posts.length).padStart(2, '0')}</span>
        <span class="text-muted font-mono text-[11px]">/</span>
        <span class="font-mono text-[11px] text-muted">TOPICS:</span>
        <span class="font-mono text-[12px] text-accent">{String(topics).padStart(2, '0')}</span>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pt-4 pb-16">

    <div class="lg:col-span-8 flex flex-col gap-10">
      <BlogTopicFilters client:load posts={posts.map(p => ({ slug: p.id, title: p.data.title, category: p.data.category, categoryLabel: p.data.categoryLabel ?? categoryLabel(p.data.category), categoryColor: p.data.categoryColor ?? categoryColor(p.data.category) }))} />

      {posts.map((post, i) => (
        <a
          href={`/blog/${post.id}`}
          data-post-card
          data-slug={post.id}
          data-category={post.data.category}
          data-title={post.data.title}
          class={`group relative overflow-hidden bg-card border border-line hover:border-accent ${i === 0 ? 'p-6 lg:p-8' : 'p-6'} rounded-xl transition-all duration-300 flex flex-col gap-4 no-underline`}
        >
          {i === 0 && (
            <div class="absolute top-0 right-0 w-64 h-64 pointer-events-none rounded-tr-xl" style="background:radial-gradient(circle at top right, color-mix(in srgb, var(--color-signal) 12%, transparent), transparent 70%);"></div>
          )}

          <div class="relative flex flex-wrap items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-body font-medium text-[12.5px]" style={tagStyle(post.data.categoryColor ?? categoryColor(post.data.category), categoryTextColor(post.data.category))}>
              <span class="w-1.5 h-1.5 rounded-full" style={`background:${post.data.categoryColor ?? categoryColor(post.data.category)}`}></span>
              {post.data.categoryLabel ?? categoryLabel(post.data.category)}
            </span>
            <span class="font-body text-[13.5px] text-muted">
              <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
              <span aria-hidden="true" class="mx-1.5 text-[#98A2B3]">·</span><span class="sr-only">, </span>
              {readTime(post.body || '')} min read
            </span>
          </div>

          <h2 class={`relative font-display ${i === 0 ? 'text-[28px]' : 'text-2xl'} text-ink group-hover:text-accent transition-colors leading-snug`}>
            {post.data.title}
          </h2>
          <p class="relative text-muted leading-relaxed">{post.data.excerpt}</p>

          {post.data.codeSnippet && (
            <div class="relative w-full bg-subtle rounded-lg p-4 flex flex-col gap-2 border border-line">
              <div class="flex items-center justify-between font-mono text-[11px] text-muted pb-1">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-line"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-line"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-line"></span>
                  <span class="ml-2 font-mono">{post.data.codeSnippet.filename}</span>
                </div>
                <span class="text-muted uppercase">illustrative example</span>
              </div>
              <pre class="font-mono text-[13px] text-ink overflow-x-auto p-3 bg-canvas rounded leading-relaxed"><code>{post.data.codeSnippet.code}</code></pre>
            </div>
          )}

          {post.data.pullQuote && (
            <blockquote class="relative pl-4 py-2 border-l-2 border-accent/50 bg-subtle/60 rounded-r-lg">
              <p class="text-ink italic text-[15px]">"{post.data.pullQuote}"</p>
              <span class="font-mono text-[11px] text-muted">— from the post</span>
            </blockquote>
          )}

          <div class="relative pt-1 flex flex-wrap items-center justify-between gap-4">
            {post.data.stack && (
              <div class="flex flex-wrap gap-2">
                {post.data.stack.map(s => (
                  <span class="font-body font-medium text-[13px] leading-5 text-[#475569] bg-[#F1F5F9] px-[11px] py-1 rounded-full">{s}</span>
                ))}
              </div>
            )}
            {i === 0 ? (
              <span class="shrink-0 inline-flex items-center gap-1.5 px-[18px] py-2.5 rounded-[10px] bg-accent text-white font-body font-semibold text-[14.5px] group-hover:bg-accent-hover transition-colors">
                Read the full post <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            ) : (
              <span class="shrink-0 font-body font-semibold text-[15px] text-accent group-hover:text-accent-hover inline-flex items-center gap-1.5 transition-colors">
                Read the full post <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            )}
          </div>
        </a>
      ))}

      <p class="text-muted text-sm font-mono text-center pt-2">— that's everything so far, more notes as new projects ship —</p>
    </div>

    <aside class="lg:col-span-4 flex flex-col gap-8">
      <BlogSearch client:load />

      <div class="bg-card p-6 rounded-xl border border-line flex flex-col gap-4 font-body">
        <div class="flex items-center gap-3.5">
          <img src="/images/ahmed-photo.jpg" alt="Syed Ahmed Ali Shah" width="56" height="56" class="w-14 h-14 rounded-full object-cover shrink-0" />
          <div class="flex flex-col min-w-0">
            <a href="/about" class="font-display font-semibold text-[18px] tracking-[-0.01em] text-ink hover:text-accent transition-colors">Syed Ahmed Ali Shah</a>
            <span class="text-[13.5px] text-muted mt-0.5">Software developer · Pakistan</span>
          </div>
        </div>
        <p class="text-[14.5px] leading-relaxed text-body m-0">
          Full-stack, blockchain, and applied AI. I write about my own projects, and about things worth understanding elsewhere in software and security.
        </p>
        <div class="flex items-center gap-2.5">
          <a href={resume.contact.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub" class="w-9 h-9 rounded-full border border-line text-ink inline-flex items-center justify-center hover:border-accent hover:text-accent transition-colors"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a10.9 10.9 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/></svg></a>
          <a href={resume.contact.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn" class="w-9 h-9 rounded-full border border-line text-ink inline-flex items-center justify-center hover:border-accent hover:text-accent transition-colors"><svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a>
          <a href="/about" class="arrow-link ml-auto">About me <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <hr class="border-0 border-t border-line my-1" />
        <p class="text-[14.5px] text-body m-0">Open to freelance projects and full-time roles.</p>
        <a href="/contact" class="btn btn-primary w-full justify-center">
          Get in touch <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>

  <script>
    function applyFilters() {
      const q = (document.documentElement.dataset.blogSearch || '').trim().toLowerCase();
      const tag = document.documentElement.dataset.blogTag || 'all';
      document.querySelectorAll('[data-post-card]').forEach((el) => {
        const category = el.getAttribute('data-category') || '';
        const title = (el.getAttribute('data-title') || '').toLowerCase();
        const matchesTag = tag === 'all' || category === tag;
        const matchesQuery = q === '' || title.includes(q);
        (el as HTMLElement).style.display = matchesTag && matchesQuery ? '' : 'none';
      });
    }
    window.addEventListener('blogfilter:change', applyFilters);
    // Apply a topic passed in the address (e.g. /blog?topic=security) straight
    // away, without waiting for the filter chips to hydrate.
    const urlTopic = new URLSearchParams(location.search).get('topic');
    if (urlTopic && document.querySelector(`[data-post-card][data-category="${CSS.escape(urlTopic)}"]`)) {
      document.documentElement.dataset.blogTag = urlTopic;
      applyFilters();
    }
  </script>
</div>

</Layout>
