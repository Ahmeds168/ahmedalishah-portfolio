---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BlogFilters from '../../components/BlogFilters.tsx';

const posts = await getCollection('blog');

function readTime(body: string) {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

function tagBg(color: string) {
  return color === 'signal' ? 'bg-signal/10 text-signal' : '';
}
---
<Layout title="Blog — Syed Ahmed Ali Shah" description="Notes on the decisions behind Ahmed's projects — blockchain, systems administration, and applied AI." activePage="blog">

<main class="max-w-[1120px] mx-auto px-5 lg:px-8 bg-ink text-paper font-body">

  <section class="pt-12 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-signal animate-pulse"></span>
        <span class="font-mono text-[11px] text-signal uppercase tracking-widest">Notes // Ongoing</span>
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-bold tracking-tight">Notes from actually building the thing</h1>
      <p class="text-muted max-w-[62ch]">Short write-ups on the decisions behind the projects — not tutorials, just the reasoning.</p>
    </div>
    <div class="flex items-center gap-3 self-start md:self-end shrink-0">
      <div class="bg-card2 px-3 py-1.5 rounded-lg flex items-center gap-2 border border-line">
        <span class="font-mono text-[11px] text-muted2">POSTS:</span>
        <span class="font-mono text-[12px] text-paper">{String(posts.length).padStart(2, '0')}</span>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pt-4 pb-16">

    <div class="lg:col-span-8 flex flex-col gap-10">
      {posts.map((post, i) => (
        <a
          href={`/blog/${post.id}`}
          data-post-card
          data-slug={post.id}
          data-category={post.data.category}
          data-title={post.data.title}
          class={`group relative bg-card border border-line hover:border-signal ${i === 0 ? 'p-6 lg:p-8' : 'p-6'} rounded-xl transition-all duration-300 flex flex-col gap-4 no-underline`}
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span
              class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-mono text-[11px] ${tagBg(post.data.categoryColor)}`}
              style={post.data.categoryColor !== 'signal' ? `background:${post.data.categoryColor}1A;color:${post.data.categoryColor};` : ''}
            >
              <span class="w-1.5 h-1.5 rounded-full" style={`background:${post.data.categoryColor === 'signal' ? 'var(--color-signal)' : post.data.categoryColor}`}></span>
              {post.data.categoryLabel}
            </span>
            <span class="font-mono text-[11px] text-muted2">{readTime(post.body || '')} min read</span>
          </div>

          <h2 class={`font-display ${i === 0 ? 'text-2xl' : 'text-xl'} text-paper group-hover:text-signal transition-colors leading-snug`}>
            {post.data.title}
          </h2>
          <p class="text-muted leading-relaxed">{post.data.excerpt}</p>

          <div class="pt-1 flex items-center justify-between">
            <span class="font-mono text-[12px] text-signal inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              Read the full post <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}

      <p class="text-muted2 text-sm font-mono text-center pt-2">— that's everything so far, more notes as new projects ship —</p>
    </div>

    <aside class="lg:col-span-4 flex flex-col gap-8">
      <BlogFilters client:load posts={posts.map(p => ({ slug: p.id, title: p.data.title, category: p.data.category, categoryLabel: p.data.categoryLabel }))} />

      <div class="bg-card p-6 rounded-xl border border-line flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-signal flex items-center justify-center font-display font-bold text-ink shrink-0">AS</div>
          <div class="flex flex-col min-w-0">
            <span class="font-display font-semibold text-paper">Ahmed Ali Shah</span>
            <span class="font-mono text-[11px] text-signal">Software Developer</span>
          </div>
        </div>
        <p class="text-muted text-sm leading-relaxed">
          Full-stack, blockchain, and applied AI. I write about the reasoning behind projects, not tutorials.
        </p>
        <a href="https://github.com/Ahmeds168" target="_blank" rel="noopener" class="font-mono text-[11px] text-muted2 hover:text-signal transition-colors">
          github.com/Ahmeds168
        </a>
      </div>

      <div class="bg-card p-6 rounded-xl border border-line flex flex-col gap-2">
        <span class="font-mono text-[11px] text-signal uppercase tracking-widest">Direct</span>
        <h4 class="font-display text-lg text-paper">Want to work together?</h4>
        <p class="text-muted text-sm">Freelance work, full-time roles, or just a question about a project.</p>
        <a href="/contact" class="mt-2 inline-flex items-center justify-center gap-2 bg-signal text-ink hover:opacity-90 font-mono text-[12px] font-semibold px-4 py-2.5 rounded-lg transition-opacity">
          Get in touch →
        </a>
      </div>
    </aside>
  </div>
</main>

</Layout>
