---
import PodcastArtwork from './PodcastArtwork.astro';
interface Props { slug: string; episodeNumber: number; title: string; shortDescription: string; duration: string; date: Date; topics: string[]; hasAudio: boolean }
const { slug, episodeNumber, title, shortDescription, duration, date, topics, hasAudio } = Astro.props;
const num = String(episodeNumber).padStart(2, '0');
const dateLabel = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toUpperCase();
---
<article class="featured">
  <div class="featured-art">
    <PodcastArtwork episodeNumber={episodeNumber} topic={topics[0] ?? 'Software'} />
  </div>
  <div class="featured-body">
    <div class="featured-meta">EPISODE {num} · {duration.toUpperCase()} · {dateLabel}</div>
    <h3>{title}</h3>
    <p>{shortDescription}</p>
    <div class="tag-row">
      {topics.map(t => <span class="tag">{t}</span>)}
    </div>
    <div class="featured-actions">
      <a class="btn btn-primary" href={`/podcasts/${slug}`}>
        {hasAudio ? '▶ Listen Episode' : 'Read Episode'}
      </a>
      <a class="arrow-link" href={`/podcasts/${slug}#transcript`}>
        Read transcript <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .featured{
    display:grid;grid-template-columns:280px 1fr;gap:44px;align-items:start;
  }
  @media (max-width:760px){ .featured{grid-template-columns:1fr;gap:28px;} }
  .featured-meta{font-family:var(--font-mono);font-size:12.5px;color:var(--accent);letter-spacing:.04em;}
  .featured-body h3{margin-top:14px;font-size:clamp(24px,3.2vw,34px);letter-spacing:-0.025em;line-height:1.2;}
  .featured-body p{margin:16px 0 0;font-size:16.5px;color:var(--muted);line-height:1.7;max-width:60ch;}
  .featured-body .tag-row{margin-top:20px;}
  .featured-actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:26px;}
</style>
