---
import resume from '../data/resume.json';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-inner">
    <small>© {year} {resume.name}</small>
    <small>Built with Astro &amp; deployed on Vercel</small>
    <div class="footer-links">
      <a href={resume.contact.github} target="_blank" rel="noopener" data-track="github_click" data-track-source="footer">GitHub</a>
      <a href={resume.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={`mailto:${resume.contact.email}`}>Email</a>
      <a href="/rss.xml" class="rss-link">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
          <circle cx="6.18" cy="17.82" r="2.18"/>
          <path d="M4 10.1v2.9a8 8 0 0 1 8 8h2.9A10.9 10.9 0 0 0 4 10.1z"/>
          <path d="M4 4v2.9A14.1 14.1 0 0 1 18.1 21H21A17 17 0 0 0 4 4z"/>
        </svg>
        RSS
      </a>
    </div>
  </div>
</footer>
