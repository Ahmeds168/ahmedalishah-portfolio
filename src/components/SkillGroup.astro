---
interface Props { title: string; items: string[] }
const { title, items } = Astro.props;
---
<div class="skill-group">
  <h3>{title}</h3>
  <ul>
    {items.map(i => <li>{i}</li>)}
  </ul>
</div>

<style>
  .skill-group h3{
    font-family:var(--font-mono);font-size:12px;font-weight:500;
    letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
    padding-bottom:12px;border-bottom:1px solid var(--line);margin-bottom:14px;
  }
  .skill-group ul{list-style:none;margin:0;padding:0;}
  .skill-group li{font-size:15.5px;color:var(--body);padding:5px 0;}
</style>
